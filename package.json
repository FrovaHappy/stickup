{
  "name": "stickup",
  "version": "0.6.0",
  "description": "StickUp - Gestor de Emotes",
  "author": "FrovaHappy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/FrovaHappy/stickup.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "prebuild": "pnpm run check && vitest run && vite build && cargo test --manifest-path src-tauri/Cargo.toml",
    "build:binaries": "node scripts/build-binaries.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@lucide/svelte": "^1.69.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-dialog": "^2.8.4"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
